identifier: CinemaCamera
name: Cinema Camera
abstract: >-
  The flight camera worked like a real one: lens, sensor, aperture, focus,
  shutter and film speed, moves and paths to fly, and a viewfinder with a
  light meter.
author: Ishiaki
$kref: '#/ckan/github/IshiakiZ/ksp-cinema-camera'
$vref: '#/ckan/ksp-avc'
x_netkan_version_edit: '^[vV]?(?<version>.+)$'
license: CC-BY-4.0
tags:
  - plugin
  - graphics
depends:
  - name: Keystone
install:
  - find: CineCamera
    install_to: GameData
