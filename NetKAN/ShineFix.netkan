identifier: ShineFix
$kref: '#/ckan/github/rockmeowstar/KSP_ShineFix/asset_match/^(?:000_ShineFix|KSP_ShineFix|ShineFix-[0-9]+\.[0-9]+\.[0-9]+(?:-hotfix)?)\.zip$'
x_netkan_version_edit:
  find: ^v
  replace: ''
  strict: false
---
identifier: ShineFix
$kref: '#/ckan/spacedock/3764'
license: open-source
resources:
  license: https://github.com/rockmeowstar/KSP_ShineFix/blob/main/LICENSE
tags:
  - config
depends:
  - name: ModuleManager
  - name: Harmony2
  - name: Deferred
  - name: Shabby
install:
  - find_regexp: '(^|/)000_ShineFix(?:Dynamic)?(?=/|$)'
    install_to: GameData
