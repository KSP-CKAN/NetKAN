identifier: SmoothRunning
name: Smooth Running
abstract: >-
  The game made faster where it wastes its time, each fix measured in the game
  first. First: the terrain's update, which the game starts again at every load
  and scene change and never stops (after a session of loads, dozens of copies
  a frame).
author: Ishiaki
$kref: '#/ckan/github/IshiakiZ/ksp-smooth-running'
$vref: '#/ckan/ksp-avc'
x_netkan_version_edit: '^[vV]?(?<version>.+)$'
license: CC-BY-4.0
tags:
  - plugin
  - convenience
depends:
  - name: Keystone
    min_version: 0.8.0
  - name: Harmony2
install:
  - find: SmoothRunning
    install_to: GameData
