spec_version: v1.4
identifier: TouchGrass
name: Touch Grass
license: WTFPL

$kref: '#/ckan/spacedock/4523'

x_netkan_version_edit:
  find: '^(?<version>[0-9.]+)[ _-]?Beta$'
  replace: '${version}-Beta'
  strict: false

install:
  - find: TouchGrass
    install_to: GameData

tags:
  - plugin

