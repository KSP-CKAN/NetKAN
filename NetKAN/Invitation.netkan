{
	"spec_version": 1,
	"identifier": "Invitation",
	"name": "Invitation",
	"abstract": "A fully linear, 7-chapter narrative rescue mod: track an unknown body, race a ten-year deadline, and cross to a second star system across ranked worlds. 100% config/content — zero custom C#.",
	"abstract_localizations": {
		"ko-kr": "선형 7장 구성의 구조 서사 모드 - 미확인 천체 추적부터 10년의 시한, 그리고 진짜 두 번째 항성계 탐사까지. 100% 설정/콘텐츠 모드 - 커스텀 C# 없음."
	},
	"$kref": "#/ckan/github/cy6253/ksp-Invitation",
	"x_netkan_github": {
		"use_source_archive": true
	},
	"license": "MIT",
