  - CC-BY-4.0
$kref: '#/ckan/github/Nazfib/TransferWindowPlanner2/version_from_asset/^TransferWindowPlanner2_(?<version>v\d+\.\d+\.\d+)\.zip$'
x_netkan_force_v: true
resources:
  homepage: https://discordapp.com/invite/ZGbR6nv
tags:
  - plugin
  - information
depends:
