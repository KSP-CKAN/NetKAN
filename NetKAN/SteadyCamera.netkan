identifier: SteadyCamera
name: Steady Camera
abstract: >-
  The flight camera held steady while your craft spins: the game's camera wobble
  in a fast spin held back, all of it or as much as you like.
author: Ishiaki
$kref: '#/ckan/github/IshiakiZ/ksp-steady-camera'
$vref: '#/ckan/ksp-avc'
x_netkan_version_edit: '^[vV]?(?<version>.+)$'
license: CC-BY-4.0
tags:
  - plugin
  - convenience
depends:
  - name: Keystone
install:
  - find: SteadyCamera
    install_to: GameData
